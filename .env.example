# Public URL of the service (your Cloudflare hostname), no trailing slash.
PUBLIC_URL=https://chat.example.com

# Owner key: required to create/list/close chats. Generate with: openssl rand -hex 32
OWNER_KEY=


# Optional tuning (defaults shown)
# DEFAULT_TTL_HOURS=24
# MAX_TTL_HOURS=168
# ARCHIVE_DAYS=30
# MAX_MESSAGES=200
# MAX_MESSAGE_BYTES=8192
# MAX_JOIN_FAILURES=5
# SEND_PER_MINUTE=20
# JOIN_PER_HOUR=20
# REQUESTS_PER_MINUTE=240
# MAX_WAIT_SECONDS=30  (keep below the proxy timeout; Cloudflare tunnel cuts long-polls at ~36s)
# OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1  (allowed OAuth redirect hosts for the owner connector at /mcp/owner)
